# Example only: npm start reads the process environment; it does not load this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_FINE_TUNE_MODEL=gpt-4.1-mini
NOVEL_AUTH_MODE=local
# Required-auth example: {"token-value":{"id":"user-1","role":"owner"}}
NOVEL_AUTH_TOKENS_JSON={}
HOST=127.0.0.1
PORT=3000
# Optional absolute paths configured separately on each computer:
# NOVEL_OUTPUT_DIR=/path/to/novel-data
# NOVEL_DB_PATH=/path/to/novel-data/platform.sqlite
MODEL_MAX_CONCURRENCY=2
MODEL_MAX_QUEUE=20
DAILY_TOKEN_BUDGET=10000000
MIN_TRAINING_SAMPLES=500
# GPT-6 Astra Standard pricing snapshot 2026-10-02, USD per 1M tokens.
MODEL_INPUT_USD_PER_MILLION=10
MODEL_CACHED_INPUT_USD_PER_MILLION=1
MODEL_CACHE_WRITE_USD_PER_MILLION=12.5
MODEL_OUTPUT_USD_PER_MILLION=50
